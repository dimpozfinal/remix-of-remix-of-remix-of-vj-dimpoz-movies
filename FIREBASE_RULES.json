{
  "rules": {
    "adminSettings": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
      "password": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
        ".validate": "newData.isString() && newData.val().length >= 4"
      }
    },
    "admins": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
      "$uid": {
        ".validate": "newData.val() === true || newData.val() === false"
      }
    },
    "movies": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
      "$movieId": {
        ".validate": "newData.hasChildren(['title', 'image', 'rating', 'year'])",
        "title": { ".validate": "newData.isString() && newData.val().length > 0" },
        "image": { ".validate": "newData.isString() && newData.val().length > 0" },
        "rating": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" },
        "year": { ".validate": "newData.isNumber() && newData.val() >= 1900 && newData.val() <= 2100" },
        "videoUrl": { ".validate": "newData.isString()" },
        "category": { ".validate": "newData.isString()" },
        "genre": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isString()" },
        "streamlink": { ".validate": "newData.isString()" },
        "description": { ".validate": "newData.isString()" },
        "country": { ".validate": "newData.isString()" },
        "isTrending": { ".validate": "newData.isBoolean()" },
        "isRecentlyAdded": { ".validate": "newData.isBoolean()" }
      }
    },
    "series": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
      "$seriesId": {
        ".validate": "newData.hasChildren(['title', 'image', 'rating', 'year', 'episodes'])",
        "title": { ".validate": "newData.isString() && newData.val().length > 0" },
        "image": { ".validate": "newData.isString() && newData.val().length > 0" },
        "rating": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" },
        "year": { ".validate": "newData.isNumber() && newData.val() >= 1900 && newData.val() <= 2100" },
        "episodes": { ".validate": "newData.isString() || newData.hasChildren()" },
        "videoUrl": { ".validate": "newData.isString()" },
        "category": { ".validate": "newData.isString()" },
        "genre": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isString()" },
        "updatedAt": { ".validate": "newData.isString()" },
        "description": { ".validate": "newData.isString()" },
        "country": { ".validate": "newData.isString()" },
        "seasons": { ".validate": "newData.isNumber()" },
        "isTrending": { ".validate": "newData.isBoolean()" },
        "isRecentlyAdded": { ".validate": "newData.isBoolean()" }
      }
    },
    "originals": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')"
    },
    "music": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
      "$musicId": {
        ".validate": "newData.hasChildren(['title', 'image', 'artist'])",
        "title": { ".validate": "newData.isString() && newData.val().length > 0" },
        "image": { ".validate": "newData.isString() && newData.val().length > 0" },
        "artist": { ".validate": "newData.isString() && newData.val().length > 0" },
        "videoUrl": { ".validate": "newData.isString()" },
        "year": { ".validate": "newData.isNumber() && newData.val() >= 1900 && newData.val() <= 2100" },
        "createdAt": { ".validate": "newData.isString()" }
      }
    },
    "animation": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
      "$animationId": {
        ".validate": "newData.hasChildren(['title', 'image', 'rating', 'year'])",
        "title": { ".validate": "newData.isString() && newData.val().length > 0" },
        "image": { ".validate": "newData.isString() && newData.val().length > 0" },
        "rating": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" },
        "year": { ".validate": "newData.isNumber() && newData.val() >= 1900 && newData.val() <= 2100" },
        "episodes": { ".validate": "newData.isString() || newData.hasChildren()" },
        "videoUrl": { ".validate": "newData.isString()" },
        "genre": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isString()" }
      }
    },
    "carousel": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
      "$carouselId": {
        ".validate": "newData.hasChildren(['title', 'subtitle', 'image'])",
        "title": { ".validate": "newData.isString() && newData.val().length > 0" },
        "subtitle": { ".validate": "newData.isString()" },
        "image": { ".validate": "newData.isString() && newData.val().length > 0" },
        "videoUrl": { ".validate": "newData.isString()" },
        "type": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isString()" }
      }
    },
    "subscriptions": {
      ".read": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
      ".write": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'arthurdimpoz@gmail.com')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'arthurdimpoz@gmail.com')",
        ".validate": "newData.hasChildren(['planId', 'startDate', 'endDate', 'active'])",
        "planId": { ".validate": "newData.isString()" },
        "startDate": { ".validate": "newData.isString()" },
        "endDate": { ".validate": "newData.isString()" },
        "active": { ".validate": "newData.isBoolean()" }
      }
    },
    "watchHistory": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$contentId": {
          ".validate": "newData.hasChildren(['contentId', 'title', 'image', 'progress', 'lastWatched'])",
          "contentId": { ".validate": "newData.isString() && newData.val().length > 0" },
          "title": { ".validate": "newData.isString() && newData.val().length > 0" },
          "image": { ".validate": "newData.isString()" },
          "progress": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "videoUrl": { ".validate": "newData.isString()" },
          "type": { ".validate": "newData.isString()" },
          "lastWatched": { ".validate": "newData.isNumber()" }
        }
      }
    },
    "continueWatching": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'arthurdimpoz@gmail.com')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'arthurdimpoz@gmail.com')",
        "$contentId": {
          ".validate": "newData.hasChildren(['contentId', 'title', 'image', 'progress', 'lastWatched'])",
          "contentId": { ".validate": "newData.isString() && newData.val().length > 0" },
          "title": { ".validate": "newData.isString() && newData.val().length > 0" },
          "image": { ".validate": "newData.isString()" },
          "progress": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "contentType": { ".validate": "newData.isString()" },
          "streamlink": { ".validate": "newData.isString()" },
          "lastWatched": { ".validate": "newData.isNumber()" }
        }
      }
    },
    "wallet": {
      ".read": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
      ".write": "auth != null",
      "balance": {
        ".read": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
        ".write": "auth != null",
        ".validate": "newData.isNumber() || newData.hasChildren(['amount', 'updatedBy', 'updatedAt'])"
      },
      "transactions": {
        ".read": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
        ".write": "auth != null",
        "$txId": {
          ".validate": "newData.hasChildren(['type', 'amount', 'timestamp'])"
        }
      }
    },
    "transactions": {
      ".read": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
      ".write": "auth != null",
      ".indexOn": ["timestamp", "userId", "status"]
    },
    "navigation_activity": {
      ".read": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
      ".write": "auth != null",
      ".indexOn": ["timestamp", "userId", "section", "type"]
    },
    "user_activity": {
      ".read": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
      ".write": "auth != null",
      ".indexOn": ["timestamp", "userId", "type"]
    },
    "users": {
      ".read": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
      ".write": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'arthurdimpoz@gmail.com')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'arthurdimpoz@gmail.com')"
      }
    },
    "blockedDevices": {
      ".read": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
      ".write": "auth != null && (auth.token.email === 'arthurdimpoz@gmail.com')",
      "$deviceId": {
        ".validate": "newData.hasChildren(['blockedAt', 'reason'])",
        "blockedAt": { ".validate": "newData.isString()" },
        "reason": { ".validate": "newData.isString()" }
      }
    }
  }
}
